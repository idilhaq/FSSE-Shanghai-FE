# Copy to .env and fill in values. Do not commit the real .env.

# Public (exposed to the browser) — must be prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_API_BASE_URL=https://dummyjson.com
NEXT_PUBLIC_API_REVALIDATE_SECONDS=3600

# Server-only auth/session config (never sent to the client bundle)
SESSION_COOKIE_NAME=session_token
SESSION_TOKEN_PREFIX=token-for-
SESSION_MAX_AGE_SECONDS=3600
API_SECRET_KEY=
